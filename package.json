{
  "name": "dingdong",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "딩동 (DINGDONG) — 온라인 파티·소셜 커뮤니티",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "bundle:api": "esbuild api/party-chat.ts --bundle --format=esm --platform=node --target=node20 --outfile=.tmp/party-chat.mjs",
    "verify": "python3 scripts/verify.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
